{# Artboard shell shared by every marketing asset.
   Sizing comes from `board` (injected by render.mjs from tokens.artboard),
   so a template never hardcodes a dimension. #}
<div class="relative h-full w-full overflow-hidden bg-{{ bg | default('paper') }} font-body antialiased">
  <div class="relative h-full w-full flex flex-col">
    {% block content %}{% endblock %}
  </div>
</div>
