{# A4 event poster in the idiom of the Seerah campaign artwork.

   Density is deliberate — this audience reads posters closely rather than
   glancing past them. See brand/references/EXTRACTION.md: "do not clean this up
   into sparse Western layout". #}
{% extends "_base.njk" %}
{% import "macros/brand.njk" as b %}
{% set bg = "paper" %}

{% block content %}
<div class="flex flex-col h-full">

  {# — masthead — name centred, the organiser's mark at the right, as on the banner — #}
  <header class="relative px-12 pt-5 pb-1">
    {{ b.nameBlock("olive-mid", "xl", "center") }}
    {% if mark %}<img src="{{ mark | inline }}" alt="Team Seerah" class="absolute top-5 right-12" style="width:3.25rem">{% endif %}
  </header>

  {# — title: the campaign's own lettering on cream. `lettering` is an SVG path in the
     content JSON; without it the title is typeset, which is a fallback, not the mark. — #}
  <div class="px-12 pt-1 pb-3 text-center">
    {% if kicker %}{{ b.pill(kicker, null, "lime", "sm") }}{% endif %}
    {% if lettering %}
    <h1 class="mt-2 flex justify-center"><img src="{{ lettering | inline }}" alt="{{ title }}" style="width:42%"></h1>
    {% else %}
    <h1 lang="bn" class="mt-3 font-display font-extrabold text-3xl leading-tight text-olive-deep">{{ title }}</h1>
    {% endif %}
  </div>

  {# — the verse: its own band, plain, nothing on top of it — #}
  {% if ayah %}
  <div class="bg-olive-deep text-paper px-12 py-3 text-center">
    <p lang="bn" class="text-sm">{{ ayah }}</p>
    {% if ayahRef %}<p lang="bn" class="text-xs opacity-80 mt-1">— {{ ayahRef }}</p>{% endif %}
  </div>
  {% endif %}

  {# — date strip — #}
  <div class="flex items-center gap-5 px-12 py-3 border-b border-line">
    <span class="text-olive-deep">{{ b.icon("calendar", "2.1rem") }}</span>
    <div>
      <p lang="bn" class="font-display font-extrabold text-xl text-ink">{{ day }}, {{ dateBn | bn }}</p>
      {% if dateHijri %}<p lang="bn" class="text-ink-muted">{{ dateHijri | bn }}</p>{% endif %}
    </div>
  </div>

  {# — body — #}
  <div class="flex-1 px-12 py-2.5 flex flex-col gap-3">

    {% if prizes %}
    <section>
      {{ b.pill(prizesLabel | default("পুরস্কারসমূহ"), "gift") }}
      <div class="mt-2.5 flex flex-col gap-1">
        {% for p in prizes %}{{ b.dataRow(p.place, p.reward | bn) }}{% endfor %}
      </div>
    </section>
    {% endif %}

    {% if rules %}
    <section>
      {{ b.pill(rulesLabel | default("নিয়মাবলী"), "rules") }}
      <div class="mt-3">{{ b.ruleList(rules) }}</div>
    </section>
    {% endif %}
  </div>

  {# — contact footer — #}
  <footer class="px-12 pb-2.5">
    {{ b.contact(contacts) }}
  </footer>
</div>
{% endblock %}
