{# A4 event poster in the idiom of the Seerah campaign artwork.

   Density is deliberate — this audience reads posters closely rather than
   glancing past them. See brand/references/EXTRACTION.md: "do not clean this up
   into sparse Western layout". #}
{% extends "_base.njk" %}
{% import "macros/brand.njk" as b %}
{% set bg = "paper" %}

{% block content %}
<div class="flex flex-col h-full">

  {# — masthead — #}
  <header class="px-12 pt-6 pb-3">
    {{ b.nameBlock("olive-mid", "xl", "center") }}
  </header>

  {# — title band — #}
  <div class="bg-olive-deep text-paper px-12 py-5 text-center">
    {% if kicker %}<p lang="bn" class="text-lime font-semibold">{{ kicker }}</p>{% endif %}
    <h1 lang="bn" class="font-display font-extrabold text-3xl leading-tight mt-1.5">{{ title }}</h1>
    {% if ayah %}
    <div class="mt-3 mx-auto max-w-[82%] border-t border-paper/25 pt-2.5">
      <p lang="bn" class="text-sm italic opacity-90">{{ ayah }}</p>
      {% if ayahRef %}<p lang="bn" class="text-xs text-lime mt-1">— {{ ayahRef }}</p>{% endif %}
    </div>
    {% endif %}
  </div>

  {# — date strip — #}
  <div class="flex items-center gap-5 px-12 py-4 border-b border-line">
    <span class="text-olive-deep">{{ b.icon("calendar", "2.1rem") }}</span>
    <div>
      <p lang="bn" class="font-display font-extrabold text-xl text-ink">{{ day }}, {{ dateBn | bn }}</p>
      {% if dateHijri %}<p lang="bn" class="text-ink-muted">{{ dateHijri | bn }}</p>{% endif %}
    </div>
  </div>

  {# — body — #}
  <div class="flex-1 px-12 py-4 flex flex-col gap-5">

    {% if prizes %}
    <section>
      {{ b.pill(prizesLabel | default("পুরস্কারসমূহ"), "gift") }}
      <div class="mt-3 flex flex-col gap-1.5">
        {% for p in prizes %}{{ b.dataRow(p.place, p.reward | bn) }}{% endfor %}
      </div>
    </section>
    {% endif %}

    {% if rules %}
    <section>
      {{ b.pill(rulesLabel | default("নিয়মাবলী"), "rules") }}
      <div class="mt-4">{{ b.ruleList(rules) }}</div>
    </section>
    {% endif %}
  </div>

  {# — contact footer — #}
  <footer class="px-12 pb-4">
    {{ b.contact(contacts) }}
  </footer>
</div>
{% endblock %}
