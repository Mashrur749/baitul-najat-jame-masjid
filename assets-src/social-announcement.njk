{# 1080×1080 feed post. Big type, one idea, lime as ground never as text. #}
{% extends "_base.njk" %}
{% import "macros/brand.njk" as b %}
{% set bg = "paper" %}

{% block content %}
{# Lime sun disc bleeding off the corner — the reference's one big graphic gesture,
   carried over as a permanent device (the desert scene around it was campaign-only). #}
<div data-bleed class="absolute rounded-pill bg-lime opacity-90"
     style="width:52%;aspect-ratio:1;right:-12%;bottom:-16%"></div>
<div class="relative flex flex-col h-full p-16">
  <header class="flex items-start justify-between gap-6">
    {{ b.nameBlock("olive-mid", "xl", "start", false) }}
    {% if eyebrow %}{{ b.pill(eyebrow, null, "lime", "sm") }}{% endif %}
  </header>

  <div class="flex-1 flex flex-col justify-center max-w-[78%]">
    <h1 lang="bn" class="font-display font-extrabold text-olive-deep text-6xl leading-tight">{{ title }}</h1>
    {% if titleEn %}<p class="mt-4 text-3xl text-ink-muted">{{ titleEn }}</p>{% endif %}
    {% if body %}<p lang="bn" class="mt-6 text-2xl leading-snug text-ink max-w-[90%]">{{ body }}</p>{% endif %}
  </div>

  <footer>
    {{ b.rule("100%", "lime") }}
    <div class="flex items-end justify-between gap-6 pt-5">
      <div class="flex flex-col gap-1">
        {% for row in details %}
        <p lang="bn" class="text-xl text-ink"><span class="text-ink-muted">{{ row.label }}</span> &nbsp;{{ row.value | bn }}</p>
        {% endfor %}
      </div>
      {# Sits on the disc: ink, the only text colour lime takes. #}
      {% if cta %}<p class="font-display font-extrabold text-2xl text-ink">{{ cta }}</p>{% endif %}
    </div>
  </footer>
</div>
{% endblock %}
