{# 1080×1080 feed post. Thumb-stopping means: big type, high contrast, one idea. #}
{% extends "_base.njk" %}
{% import "macros/brand.njk" as b %}
{% set bg = "paper" %}
{% set motifOn = "light" %}

{% block content %}
<div class="flex flex-col h-full p-20">
  <header class="flex items-center justify-between">
    {{ b.wordmark("sm", "primary") }}
    {% if eyebrow %}
    <span class="rounded-pill bg-primary-soft px-4 py-2 text-xs uppercase tracking-[0.2em] text-primary font-medium">{{ eyebrow }}</span>
    {% endif %}
  </header>

  <div class="flex-1 flex flex-col justify-center">
    <h1 class="font-display font-semibold text-primary text-[5.5rem] leading-[0.92] text-balance">{{ title }}</h1>
    {% if titleBn %}<p lang="bn" class="mt-5 text-4xl text-ink-muted">{{ titleBn }}</p>{% endif %}
    {% if body %}<p class="mt-8 text-2xl leading-snug text-ink max-w-[85%]">{{ body }}</p>{% endif %}
  </div>

  <footer>
    {{ b.rule("100%") }}
    <div class="flex items-end justify-between pt-6">
      <div>
        {% for row in details %}
        <p class="text-xl text-ink"><span class="text-ink-muted">{{ row.label }}</span> &nbsp;{{ row.value }}</p>
        {% endfor %}
      </div>
      {% if cta %}<p class="font-display text-2xl text-primary">{{ cta }}</p>{% endif %}
    </div>
  </footer>
</div>
{% endblock %}
