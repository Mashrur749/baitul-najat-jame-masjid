---
layout: layouts/base.njk
title: নাজাত টিভি ও মিডিয়া
description: "Najat TV — বায়তুন নাযাত জামে মসজিদের খুতবা, আলোচনা, ইমামের পডকাস্ট ও লাইভ প্রোগ্রাম। Najat TV: talks and live programmes from Baitun Najat Jame Masjid, Sylhet."
permalink: /media/
lang: bn
---
{% import "macros/brand.njk" as b %}
{% set img = "/images/event-2026" %}

{% call b.pageHead("Najat TV", "নাজাত টিভি ও মিডিয়া",
   "খুতবা, আলোচনা, ইমামের পডকাস্ট, লাইভ প্রোগ্রাম ও মসজিদের খবর।",
   "Najat TV — talks, live programmes and news from Baitun Najat on YouTube and Facebook.", "play") %}
  {{ b.videoFrame("৩য় সীরাত প্রতিযোগিতা ২০২৬ থেকে।") }}
{% endcall %}

{# ══ CHANNELS — a programme guide ═════════════════════════════════════════════
   Buttons appear only for channels with a URL in site.json — a dead link is worse than none. #}
<section class="mx-auto max-w-5xl px-6 section-y grid gap-8 md:gap-10 md:grid-cols-[1fr_1.4fr] md:items-center">
  <div>
    {{ b.pill("মিডিয়া ও ব্র্যান্ডিং", "broadcast") }}
    <h2 lang="bn" class="mt-5 font-display font-extrabold text-3xl lg:text-4xl leading-tight text-olive-deep text-balance">যা পাবেন নাজাত টিভিতে</h2>
    {% if site.social.youtube or site.social.facebook %}
    <div class="mt-8 flex flex-wrap gap-3">
      {% if site.social.youtube %}{{ b.btn(site.social.youtube, "ইউটিউবে দেখুন") }}{% endif %}
      {% if site.social.facebook %}{{ b.btn(site.social.facebook, "ফেসবুকে দেখুন", "secondary") }}{% endif %}
    </div>
    {% endif %}
  </div>
  <ul class="border-t border-line">
    {% for m in model.media %}
    <li class="flex items-center gap-5 border-b border-line py-5">
      {{ b.iconDisc(m.icon) }}
      <span>
        <span lang="bn" class="block font-display font-bold text-xl text-ink">{{ m.title }}</span>
        {% if m.detail %}<span lang="bn" class="block text-ink-muted">{{ m.detail }}</span>{% endif %}
      </span>
    </li>
    {% endfor %}
  </ul>
</section>

{# ══ FROM THE CAMERA — the consented 2026 set as a bento ═════════════════════ #}
<section class="bg-surface border-y border-line">
  <div class="mx-auto max-w-5xl px-6 section-y">
    {{ b.sectionHead("ক্যামেরায়", "৩য় সীরাত প্রতিযোগিতা ২০২৬", "camera") }}
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:grid-rows-2">
      {{ b.figure(img + "/hall-packed.jpg", "প্রতিযোগীতে ভরা মসজিদের হল", null, "4/3", "col-span-2 md:row-span-2 [&>div]:md:h-full") }}
      {{ b.figure(img + "/ceremony-audience.jpg", "মঞ্চ ও দর্শকসারি, পেছনে প্রতিযোগিতার ব্যানার", null, "4/3") }}
      {{ b.figure(img + "/stage-dignitaries.jpg", "মঞ্চে অতিথিরা", null, "4/3") }}
    </div>
    <a href="/events/seerah-2026/" lang="bn" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">আয়োজনটি দেখুন {{ b.icon("arrow") }}</a>
  </div>
</section>

{# ══ MEDIA TEAM ══════════════════════════════════════════════════════════════ #}
<section class="relative overflow-hidden bg-olive-deep text-paper">
  {{ b.pattern("media-lattice", "paper") }}
  <div class="relative mx-auto max-w-5xl px-6 strip-y flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 lang="bn" class="font-display font-extrabold text-2xl md:text-3xl leading-tight">মিডিয়া টিমে যোগ দিন</h2>
      <p lang="bn" class="mt-2 text-lg">ছবি, ভিডিও ও সোশ্যাল মিডিয়া — <span lang="en">Ansar of Najat</span>-এর মিডিয়া টিমের কাজ।</p>
    </div>
    <div class="flex flex-wrap gap-3">{{ b.btn("/ansar/#register", "রেজিস্ট্রেশন করুন", "paper") }}</div>
  </div>
</section>
