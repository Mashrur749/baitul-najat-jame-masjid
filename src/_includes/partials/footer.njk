{% import "macros/brand.njk" as b %}
{% import "macros/logo.njk" as logo %}
{# No top margin: most pages end on an olive band, and a paper strip between it and the
   footer read as a gap. Pages that end on paper carry their own bottom padding. #}
<footer class="bg-olive-deep text-paper border-t border-paper/15">
  {# Every line here is full paper on olive-deep (5.19:1). Dimmed paper fails 4.5:1. #}
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      {# The masjid's own logo, in paper on the olive band; the Bangla name under it. #}
      {{ logo.lockup("footer-logo", "w-44 md:w-56 h-auto", "Baitun Najat Jame Mosque") }}
      <p lang="bn" class="mt-6 font-display font-extrabold text-2xl">{{ site.nameBn }}</p>
      <div class="mt-6 flex flex-col gap-2">
        <p class="flex gap-3 items-start"><span class="mt-0.5">{{ b.icon("pin", "1.2em") }}</span><span lang="bn">{{ site.address }}</span></p>
        <div class="flex gap-3 items-start"><span class="mt-3.5">{{ b.icon("phone", "1.2em") }}</span>
          {# Two separate 48px rows: an inline pair 11px apart triggers the tap-disambiguation magnifier. #}
          <div class="flex flex-col gap-2">{% for ph in site.phones %}<a href="{{ ph | tel }}" class="flex min-h-12 items-center tabular-nums hover:underline">{{ ph }}</a>{% endfor %}</div>
        </div>
      </div>
    </div>

    <nav aria-label="পাতাসমূহ" lang="bn">
      <p class="font-semibold">পাতাসমূহ</p>
      {# Full-width rows 8px apart: stacked inline links touched, and a thumb hit the neighbour. #}
      <ul class="mt-2 grid grid-cols-2 gap-x-6 gap-y-2 md:grid-cols-1">
        <li><a href="/" class="flex min-h-11 items-center hover:underline">হোম</a></li>
        {% for l in nav %}<li><a href="{{ l.href }}" class="flex min-h-11 items-center hover:underline">{{ l.label }}</a></li>{% endfor %}
        <li><a href="/donate/" class="flex min-h-11 items-center hover:underline">দান করুন</a></li>
      </ul>
    </nav>

    <div>
      <p lang="bn" class="font-semibold">আমাদের উদ্যোগ</p>
      <ul class="mt-2 flex flex-col gap-2">
        {% for br in model.brands %}
        <li><a href="{{ br.href }}" class="inline-flex min-h-11 flex-wrap items-center gap-x-1.5 hover:underline"><span lang="en" class="font-semibold whitespace-nowrap">{{ br.name }}</span><span lang="bn" class="whitespace-nowrap">· {{ br.role }}</span></a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</footer>
