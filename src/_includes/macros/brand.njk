<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     style="width:{{ size }};height:{{ size }};flex:none">
  <path d="{{ paths[name] }}"/>
</svg>
{% endmacro %}

{# ---------- Pill header — THE structural device --------------------------- #}
{# tone "lime" puts ink on top; tone "olive-deep" puts paper on top. Enforced here
   so a caller cannot accidentally create an unreadable pairing. #}
{% macro pill(label, ico=null, tone="lime", size="base") %}
{% set fg = "ink" if tone == "lime" else "paper" %}
<span class="inline-flex items-center gap-2 rounded-pill bg-{{ tone }} text-{{ fg }}
             px-5 py-2 font-body font-semibold text-{{ size }}">
  {% if ico %}{{ icon(ico, "1.15em") }}{% endif %}{{ label }}
</span>
{% endmacro %}

{# ---------- Sun disc ------------------------------------------------------- #}
{# Lime circle used as a ground for numerals or illustration. #}
{% macro sunDisc(size="12rem", content=null) %}
<div class="rounded-pill bg-lime flex items-center justify-center text-ink font-display"
     style="width:{{ size }};height:{{ size }}">{{ content | default("") }}</div>
{% endmacro %}

{# ---------- Name block ----------------------------------------------------- #}
{# Bangla is the name. English is a transliteration, not the primary form. #}
{% macro nameBlock(tone="olive-mid", size="2xl", align="center", withAddress=true) %}
<div class="text-{{ align }}">
  <p lang="bn" class="font-display font-extrabold text-{{ size }} text-{{ tone }} leading-tight">
    বায়তুন নাযাত জামে মসজিদ
  </p>
  {% if withAddress %}
  <p lang="bn" class="font-body text-ink mt-1.5 opacity-85">
    ই. এফ. আই ব্লক, শাহজালাল উপশহর, সিলেট।
  </p>
  {% endif %}
</div>
{% endmacro %}

{# ---------- Rule ----------------------------------------------------------- #}
{% macro rule(width="6rem", tone="lime", align="left") %}
<div class="h-1 rounded-pill bg-{{ tone }} {{ 'mx-auto' if align == 'center' }}" style="width: {{ width }}"></div>
{% endmacro %}

{# ---------- Arabic -------------------------------------------------------- #}
{# NEVER pass through a transform, gradient, or overlay. brand/BRAND.md §2. #}
{% macro arabic(text, size="text-3xl") %}
<p lang="ar" dir="rtl" class="font-arabic {{ size }} text-balance">{{ text }}</p>
{% endmacro %}

{# ---------- Boxed data row (prize table idiom) ---------------------------- #}
{% macro dataRow(label, value) %}
<div class="flex items-stretch rounded-md overflow-hidden border border-line">
  <div lang="bn" class="bg-lime text-ink font-semibold px-4 py-1.5 min-w-[8.5rem]">{{ label }}</div>
  <div lang="bn" class="bg-surface text-ink px-4 py-1.5 flex-1">{{ value }}</div>
</div>
{% endmacro %}

{# ---------- Numbered rules list ------------------------------------------- #}
{% macro ruleList(items) %}
<ol class="flex flex-col gap-2">
  {% for it in items %}
  <li lang="bn" class="flex gap-3 text-ink leading-snug">
    <span class="font-semibold text-olive-mid shrink-0">{{ loop.index | bn }}.</span>
    <span>{{ it }}</span>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{# ---------- Prayer times --------------------------------------------------- #}
{# Bangla-first: the Bangla name leads, English is the smaller gloss. #}
{% macro prayerTable(times, tone="ink") %}
<table class="w-full text-{{ tone }} font-body">
  {# Two times per row mean nothing without column names — the reader has to know
     which one is the jamaat. #}
  <thead>
    <tr lang="bn" class="text-sm opacity-70 border-b border-line">
      <th scope="col" class="text-start font-medium pb-2">নামাজ</th>
      <th scope="col" class="text-end font-medium pb-2">আযান</th>
      <th scope="col" class="text-end font-medium pb-2">জামাত</th>
    </tr>
  </thead>
  <tbody>
  {% for t in times %}
    <tr class="border-b border-line last:border-0">
      <td class="py-3">
        <span lang="bn" class="font-semibold text-lg">{{ t.bn }}</span>
        <span class="opacity-55 text-sm ms-2">{{ t.name }}</span>
      </td>
      <td class="py-3 text-end opacity-70" lang="bn">{{ t.athan | bn }}</td>
      <td class="py-3 text-end font-semibold" lang="bn">{{ t.iqamah | bn }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{# ---------- Contact block -------------------------------------------------- #}
{% macro contact(items, tone="olive-deep") %}
<div class="bg-{{ tone }} text-paper rounded-lg p-4 flex flex-col gap-2.5">
  {% for it in items %}
  <div class="flex gap-3 items-start">
    <span class="text-lime mt-0.5">{{ icon(it.icon, "1.3em") }}</span>
    <div>
      <p lang="{{ it.lang | default('bn') }}" class="font-semibold">{{ it.title }}</p>
      {% if it.detail %}<p lang="{{ it.lang | default('bn') }}" class="text-sm mt-0.5">{{ it.detail }}</p>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{# ---------- Photo figure --------------------------------------------------- #}
{# Photographs are the evidence on this site, so they get real captions rather
   than being decoration. `ratio` keeps layout stable before images load. #}
{% macro figure(src, alt, caption=null, ratio="4/3", cls="") %}
<figure class="{{ cls }}">
  <div class="overflow-hidden rounded-lg bg-line" style="aspect-ratio:{{ ratio }}">
    <img src="{{ src }}" alt="{{ alt }}" loading="lazy" decoding="async"
         class="w-full h-full object-cover">
  </div>
  {% if caption %}
  <figcaption lang="bn" class="mt-3 text-sm text-ink-muted leading-snug">{{ caption }}</figcaption>
  {% endif %}
</figure>
{% endmacro %}

{# ---------- Stat ----------------------------------------------------------- #}
{# Specific numbers read as real; round claims read as marketing. #}
{% macro stat(value, label, note=null) %}
<div class="border-t-2 border-lime pt-4">
  <p lang="bn" class="font-display font-extrabold text-4xl text-olive-deep leading-none">{{ value | bn }}</p>
  <p lang="bn" class="mt-2 font-semibold text-ink">{{ label }}</p>
  {% if note %}<p lang="bn" class="text-sm text-ink-muted mt-0.5">{{ note }}</p>{% endif %}
</div>
{% endmacro %}

{# ---------- Section heading ------------------------------------------------ #}
{% macro sectionHead(eyebrow, title, ico=null) %}
<div class="mb-8">
  {% if eyebrow %}{{ pill(eyebrow, ico) }}{% endif %}
  <h2 lang="bn" class="mt-5 font-display font-extrabold text-3xl text-olive-deep text-balance">{{ title }}</h2>
</div>
{% endmacro %}

{# ---------- Date tile ------------------------------------------------------ #}
{# The banner's lime calendar: big Bengali day numeral on a lime square, detail beside.
   `greg` is "22 আগস্ট, 2026 ঈসায়ী" — the day is split off, the rest is the caption. #}
{% macro dateTile(greg, weekday, label, hijri=null) %}
{% set parts = greg.split(" ") %}
<div class="flex items-center gap-4">
  <div class="shrink-0 w-16 h-16 rounded-md bg-lime text-ink flex items-center justify-center">
    <span lang="bn" class="font-display font-extrabold text-3xl leading-none">{{ parts[0] | bn }}</span>
  </div>
  <div lang="bn">
    <p class="font-semibold text-ink leading-tight">{{ label }}</p>
    <p class="text-sm text-ink-muted mt-1">{{ weekday }}, {{ parts.slice(1).join(" ") | replace(",", "") | bn }}</p>
    {% if hijri %}<p class="text-xs text-ink-muted mt-0.5">{{ hijri | bn }}</p>{% endif %}
  </div>
</div>
{% endmacro %}

{# ═══════════ Site building blocks (website only) ═══════════════════════════ #}

{# ---------- Icon disc: an icon on the lime sun disc ----------------------- #}
{% macro iconDisc(name, size="3rem") %}
<span class="inline-flex items-center justify-center rounded-pill bg-lime text-ink shrink-0"
      style="width:{{ size }};height:{{ size }}" aria-hidden="true">{{ icon(name, "50%") }}</span>
{% endmacro %}

{# ---------- Buttons -------------------------------------------------------- #}
{# min-h-12: every action is a 48px target. "paper" and "paperOutline" are for olive-deep
   bands, where paper is the only legible foreground. #}
{% macro btn(href, label, variant="primary") %}
{% set cls = {
  primary:      "bg-lime text-ink hover:bg-olive-deep hover:text-paper active:bg-olive-deep active:text-paper transition-colors",
  secondary:    "border border-ink/30 text-ink hover:bg-ink/5 active:bg-ink/10 transition-colors",
  paper:        "bg-paper text-ink hover:underline",
  paperOutline: "border border-paper/60 text-paper hover:bg-paper/10 transition-colors"
} %}
<a href="{{ href }}" lang="bn" class="inline-flex min-h-12 items-center justify-center rounded-pill font-semibold px-6 {{ cls[variant] }}">{{ label }}</a>
{% endmacro %}

{# ---------- Call button: dialling is the action that matters ------------- #}
{% macro callButton(phone, label=null, tone="lime") %}
<a href="{{ phone | tel }}"
   class="inline-flex min-h-12 items-center justify-center gap-2 rounded-pill font-semibold tabular-nums px-6 {{ 'bg-lime text-ink hover:bg-olive-deep hover:text-paper active:bg-olive-deep active:text-paper transition-colors' if tone == 'lime' else 'bg-paper text-ink hover:underline' }}">
  {{ icon("phone", "1.1em") }}{% if label %}<span lang="bn">{{ label }}</span>{% endif %}<span>{{ phone }}</span>
</a>
{% endmacro %}

{# ---------- Page head: the top of every inner page ------------------------ #}
{# The sun disc sits bottom-right and only from md up, where the text column leaves it
   room: olive-deep headline type over lime would be the 2.89:1 pairing tokens forbid. #}
{% macro pageHead(eyebrow, title, intro=null, en=null, ico=null) %}
<section class="relative overflow-hidden border-b border-line">
  <div data-bleed aria-hidden="true" class="hidden md:block absolute -bottom-24 -right-16 w-72 h-72 rounded-pill bg-lime"></div>
  <div class="relative mx-auto max-w-5xl px-6 pt-10 pb-10 md:pt-16 md:pb-16">
    {{ pill(eyebrow, ico) }}
    <h1 lang="bn" class="mt-6 max-w-2xl font-display font-extrabold text-4xl md:text-5xl leading-tight text-olive-deep text-balance">{{ title }}</h1>
    {% if intro %}<p lang="bn" class="mt-5 max-w-2xl text-lg sm:text-xl leading-relaxed text-ink">{{ intro }}</p>{% endif %}
    {% if en %}<p lang="en" class="mt-3 max-w-2xl text-sm text-ink-muted">{{ en }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{# ---------- Tile: icon + one line, for lists of programmes ---------------- #}
{% macro tile(ico, title, detail=null) %}
<li class="flex items-center gap-4 rounded-lg bg-surface border border-line p-4">
  {{ iconDisc(ico) }}
  <div>
    <p lang="bn" class="font-semibold text-ink leading-snug">{{ title }}</p>
    {% if detail %}<p lang="bn" class="text-sm text-ink-muted">{{ detail }}</p>{% endif %}
  </div>
</li>
{% endmacro %}

{# ---------- Card: icon disc, title, bullet lines, optional tag and call ---- #}
{% macro card(ico, title, items=[], tag=null, tagHref=null, id=null, phone=null) %}
<article {% if id %}id="{{ id }}"{% endif %} class="rounded-lg bg-surface border border-line p-6 flex flex-col gap-4 scroll-mt-24">
  <div class="flex items-center gap-4">
    {{ iconDisc(ico) }}
    <h3 lang="bn" class="font-display font-extrabold text-xl text-ink leading-snug">{{ title }}</h3>
  </div>
  {% if items and items.length %}
  <ul class="flex flex-col gap-2">
    {% for it in items %}
    <li lang="bn" class="flex gap-3 text-ink leading-snug"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-pill bg-olive-deep"></span><span>{{ it }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if phone %}<div class="pt-1">{{ callButton(phone, "কল করুন") }}</div>{% endif %}
  {% if tag %}
  <p class="mt-auto pt-3 border-t border-line text-sm font-semibold text-ink">
    {% if tagHref %}<a href="{{ tagHref }}" class="inline-flex min-h-11 items-center gap-2 hover:underline">{{ tag }} {{ icon("arrow") }}</a>{% else %}{{ tag }}{% endif %}
  </p>
  {% endif %}
</article>
{% endmacro %}

{# ---------- Week tile: the monthly programme flow ------------------------- #}
{% macro weekTile(n, title) %}
<div class="flex items-center gap-4 rounded-lg bg-surface border border-line p-4">
  {# Bangla needs its leading even at xs: at line-height 1 the matra rode the square's top edge. #}
  <div class="shrink-0 w-16 h-[4.5rem] rounded-md bg-lime text-ink flex flex-col items-center justify-center">
    <span lang="bn" class="text-xs font-semibold leading-normal">সপ্তাহ</span>
    <span lang="bn" class="font-display font-extrabold text-2xl leading-none">{{ n | bn }}</span>
  </div>
  <p lang="bn" class="font-semibold text-lg text-ink leading-snug">{{ title }}</p>
</div>
{% endmacro %}

{# ---------- Status pill: আসন্ন / চলমান on lime, সম্পন্ন on olive-deep ------- #}
{% macro statusPill(a) %}
{% if a.status == "past" %}{{ pill(a.statusLabel, "check", "olive-deep", "sm") }}{% else %}{{ pill(a.statusLabel, "clock", "lime", "sm") }}{% endif %}
{% endmacro %}

{# ---------- Activity card: one event from the admins' sheet ------------------ #}
{# The poster keeps its own shape: posters carry text, and a crop would cut it. The image
   link is a duplicate of the title link, so it is hidden from keyboard and screen reader. #}
{% macro activityCard(a) %}
<article class="w-full flex flex-col overflow-hidden rounded-lg border border-line bg-paper">
  <a href="{{ a.href }}" tabindex="-1" aria-hidden="true" class="block bg-line">
    {% if a.poster %}
    <img src="{{ a.poster }}" alt="" loading="lazy" decoding="async"
         sizes="(min-width: 1024px) 320px, (min-width: 640px) 46vw, 82vw" class="w-full h-auto">
    {% else %}
    <div class="aspect-[4/5] bg-lime text-ink flex items-center justify-center">{{ icon("calendar", "30%") }}</div>
    {% endif %}
  </a>
  <div class="p-5 flex flex-1 flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
      {{ statusPill(a) }}
      {% if a.category %}<span lang="bn" class="text-sm text-ink-muted">{{ a.category }}</span>{% endif %}
    </div>
    <h3 lang="bn" class="font-display font-extrabold text-xl text-ink leading-snug text-balance"><a href="{{ a.href }}" class="hover:underline">{{ a.title }}</a></h3>
    <ul lang="bn" class="flex flex-col gap-1.5 text-sm text-ink">
      <li class="flex gap-2"><span class="mt-0.5 text-olive-deep">{{ icon("calendar", "1.1em") }}</span><span>{{ a.dateText }}</span></li>
      {% if a.time %}<li class="flex gap-2"><span class="mt-0.5 text-olive-deep">{{ icon("clock", "1.1em") }}</span><span>{{ a.time | bn }}</span></li>{% endif %}
      {% if a.venue %}<li class="flex gap-2"><span class="mt-0.5 text-olive-deep">{{ icon("pin", "1.1em") }}</span><span>{{ a.venue }}</span></li>{% endif %}
    </ul>
    {% if a.summary %}<p lang="bn" class="text-ink-muted leading-relaxed line-clamp-3">{{ a.summary }}</p>{% endif %}
    <div class="mt-auto flex flex-wrap items-center gap-x-5">
      <a href="{{ a.href }}" lang="bn" class="inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">বিস্তারিত দেখুন {{ icon("arrow") }}</a>
      {% if a.registration and a.status != "past" %}
      <a href="{{ a.registration }}" lang="bn" class="inline-flex min-h-11 items-center gap-2 font-semibold text-ink underline decoration-lime decoration-2 underline-offset-4 hover:decoration-olive-deep">রেজিস্ট্রেশন করুন</a>
      {% endif %}
    </div>
  </div>
</article>
{% endmacro %}

{# ---------- bKash card ------------------------------------------------------ #}
{# Until the committee supplies the number the card shows TBD rather than a blank — a
   visible placeholder is honest; an empty slot looks broken. One long-press selects the
   whole number (select-all, no JS); the copy button appears only once JS has proved the
   clipboard works, and copies the digits alone. #}
{% macro bkashCard(bkash, reference=null) %}
<div class="rounded-lg bg-paper text-ink p-6">
  <p lang="bn" class="text-sm text-olive-deep font-semibold">বিকাশে দান করুন</p>
  {% if bkash and bkash.number %}
  <p class="mt-3 font-display font-extrabold text-3xl tabular-nums select-all">{{ bkash.number }}</p>
  <button type="button" hidden lang="bn" data-copy="{{ bkash.number | replace('-', '') }}"
          class="mt-3 min-h-12 rounded-pill border border-ink/30 text-ink font-semibold px-4 hover:bg-ink/5 active:bg-ink/10 transition-colors">নম্বর কপি করুন</button>
  <p lang="bn" class="mt-2 text-ink-muted">
    bKash অ্যাপে <span class="font-semibold text-ink">{{ "Payment" if bkash.type == "merchant" else "Send Money" }}</span> নির্বাচন করুন
  </p>
  {% if reference %}
  <p lang="bn" class="mt-4 text-sm text-ink-muted border-t border-line pt-3">রেফারেন্সে <span class="font-semibold text-ink">{{ reference }}</span> লিখুন।</p>
  {% endif %}
  <script>
    document.querySelectorAll("[data-copy]:not([data-ready])").forEach(function (b) {
      b.setAttribute("data-ready", "");
      if (!navigator.clipboard) return;
      b.hidden = false;
      b.addEventListener("click", function () {
        navigator.clipboard.writeText(b.dataset.copy).then(function () { b.textContent = "কপি হয়েছে"; });
      });
    });
  </script>
  {% else %}
  <p class="mt-3 font-body font-bold text-3xl text-ink-muted">TBD</p>
  <p lang="bn" class="mt-2 text-ink-muted">বিকাশ নম্বর শীঘ্রই এখানে যুক্ত হবে। আপাতত নিচের নম্বরে যোগাযোগ করুন।</p>
  {% endif %}
</div>
{% endmacro %}

{# ---------- Contact card, for olive-deep bands ------------------------------ #}
{# No paper tint on olive: the text has to sit on solid olive-deep to reach 5.19:1. #}
{% macro contactCard(name, title, phone, org, address) %}
<div class="rounded-lg border border-paper/20 p-6">
  <p lang="bn" class="text-sm font-semibold">যোগাযোগ</p>
  <p lang="bn" class="mt-3 font-semibold text-lg">{{ name }}</p>
  <p lang="bn" class="text-sm mt-1">{{ title }}</p>
  <a href="{{ phone | tel }}"
     class="mt-4 flex min-h-12 items-center justify-center gap-2 rounded-pill bg-paper text-ink font-semibold text-lg tabular-nums px-6 hover:underline">{{ icon("phone", "1.1em") }}{{ phone }}</a>
  <p lang="bn" class="mt-4 text-sm border-t border-paper/20 pt-3">{{ org }}<br>{{ address }}</p>
</div>
{% endmacro %}
