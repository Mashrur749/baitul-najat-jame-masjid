{#
  Brand macro library — the shared vocabulary.
  Imported by BOTH the website (src/**) and the asset templates (assets-src/**).

  Devices here are taken from the Seerah campaign artwork, not invented:
  the pill header, the lime sun disc, the Bangla-first name block.
  See brand/references/EXTRACTION.md for what was taken and what was rejected.

  COLOUR CONTRACT (measured — see tokens.colorRules):
    lime and olive-deep are GROUNDS ONLY.  ink on lime.  paper on olive-deep.
    Never lime as text. Never ink on olive-deep.
#}

{# ---------- Icons ---------------------------------------------------------- #}
{% macro icon(name, size="1em") %}
{% set paths = {
  pin:       "M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  phone:     "M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z",
  person:    "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0z",
  calendar:  "M4 6h16v15H4z M8 3v4 M16 3v4 M4 10h16",
  gift:      "M3 11h18v10H3z M3 7h18v4H3z M12 7v14 M12 7S9 3 7 4s0 3 5 3z M12 7s3-4 5-3-0 3-5 3z",
  rules:     "M8 4h8v3H8z M6 6h2 M16 6h2v15H6V6 M9 11h6 M9 15h6",
  trophy:    "M7 4h10v6a5 5 0 0 1-10 0z M7 6H4v2a3 3 0 0 0 3 3 M17 6h3v2a3 3 0 0 1-3 3 M10 16h4l1 5H9z",
  book:      "M12 6c-2-1.5-5-2-8-2v14c3 0 6 .5 8 2 2-1.5 5-2 8-2V4c-3 0-6 .5-8 2z M12 6v14",
  cap:       "M2 9l10-5 10 5-10 5z M6 11v5c3 2.5 9 2.5 12 0v-5 M22 9v5",
  heart:     "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z",
  people:    "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M2 20a7 7 0 0 1 14 0 M16 4.5a3.5 3.5 0 0 1 0 6.5 M18 14a6 6 0 0 1 4 6",
  userplus:  "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M2 20a7 7 0 0 1 14 0 M19 8v6 M16 11h6",
  pulse:     "M3 12h4l2-5 4 10 2-5h6",
  play:      "M3 5h18v12H3z M10 8.5v5l4-2.5z M8 21h8",
  mic:       "M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z M5 11a7 7 0 0 0 14 0 M12 18v3",
  broadcast: "M12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M8.5 8.5a5 5 0 0 0 0 7 M15.5 8.5a5 5 0 0 1 0 7 M5.6 5.6a9 9 0 0 0 0 12.8 M18.4 5.6a9 9 0 0 1 0 12.8",
  megaphone: "M3 10v4h4l7 4V6l-7 4z M17 9a4 4 0 0 1 0 6 M19.5 6.5a8 8 0 0 1 0 11",
  moon:      "M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z",
  star:      "M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5l-5.3 2.9 1.2-6-4.5-4.1 6-.7z",
  mosque:    "M12 3c-3 3-6 4-6 8h12c0-4-3-5-6-8z M4 21V11 M20 21V11 M6 11v10h12V11 M10 21v-4a2 2 0 0 1 4 0v4",
  cross:     "M9 3h6v6h6v6h-6v6H9v-6H3V9h6z",
  ambulance: "M2 7h12v10H2z M14 10h4l4 3.5V17h-8 M6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M17 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M8 9.5v5 M5.5 12h5",
  box:       "M3 7l9-4 9 4v10l-9 4-9-4z M3 7l9 4 9-4 M12 11v10",
  hand:      "M18 11V6a1.5 1.5 0 0 0-3 0v4 M15 10V4.5a1.5 1.5 0 0 0-3 0V10 M12 10V5.5a1.5 1.5 0 0 0-3 0V12 M9 12V8.5a1.5 1.5 0 0 0-3 0V15a6 6 0 0 0 6 6h1a5 5 0 0 0 5-5v-5a1.5 1.5 0 0 0-3 0",
  bag:       "M5 8h14l-1 13H6z M9 8a3 3 0 0 1 6 0",
  food:      "M3 11h18a9 9 0 0 1-18 0z M8 7c0-1 1-1.5 1-3 M12 7c0-1 1-1.5 1-3 M16 7c0-1 1-1.5 1-3",
  camera:    "M3 8h4l2-3h6l2 3h4v11H3z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
