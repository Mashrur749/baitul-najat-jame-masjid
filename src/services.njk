{# ══ THE ONE CALL ════════════════════════════════════════════════════════════
   First on the page, and the only call button for every service: someone arriving here
   at 2am needs one number to press, not a choice between cards. #}
<section class="bg-olive-deep text-paper">
  <div class="mx-auto max-w-5xl px-6 py-8 md:py-10 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 lang="bn" class="font-display font-extrabold text-2xl text-balance">যেকোনো সেবার জন্য কল করুন</h2>
      <p lang="bn" class="mt-1">ত্রাণ, মেডিকেল ক্যাম্প, জানাজা সাপোর্ট (২৪/৭) ও অ্যাম্বুলেন্স</p>
    </div>
    {{ b.callButton(site.phones[0], "কল করুন", "paper") }}
  </div>
</section>

{# ══ SERVICES ════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
  {{ b.sectionHead("মূল সেবা", "Rahma Services-এর কাজ") }}
  <div class="grid gap-6 md:grid-cols-2">
    {% for s in model.services %}{{ b.card(s.icon, s.title, s.items, null, null, s.id) }}{% endfor %}
  </div>
</section>

{# ══ NAJAT BAZAAR ════════════════════════════════════════════════════════════ #}
<section id="bazaar" class="bg-surface border-y border-line scroll-mt-24">
