    <div>
      {{ b.sectionHead(model.bazaar.name, model.bazaar.title, "bag") }}
      <p lang="bn" class="-mt-2 text-lg leading-relaxed text-ink">{{ model.bazaar.intro }}</p>
    </div>
    <ul class="grid gap-4">
      <li class="flex items-center gap-4 rounded-lg bg-paper border border-line p-4">{{ b.iconDisc("bag") }}<p lang="bn" class="font-semibold text-ink">ইসলামিক পণ্য</p></li>
      <li class="flex items-center gap-4 rounded-lg bg-paper border border-line p-4">{{ b.iconDisc("mosque") }}<p lang="bn" class="font-semibold text-ink">আয় যায় মসজিদ ফান্ডে</p></li>
    </ul>
  </div>
</section>

{# ══ ASK ═════════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
