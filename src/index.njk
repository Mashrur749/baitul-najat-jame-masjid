---
layout: layouts/base.njk
title: হোম
lang: bn
description: নামাজের সময়, কার্যক্রম ও কমিউনিটি — বায়তুন নাযাত জামে মসজিদ।
---
{% import "macros/brand.njk" as b %}

<section class="bg-olive-deep text-paper">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h1 lang="bn" class="font-display font-extrabold text-5xl leading-tight text-balance">সবাই স্বাগতম</h1>
    <div class="mt-6">{{ b.rule("5rem", "lime") }}</div>
    <p lang="bn" class="mt-6 max-w-xl text-lg opacity-90">
      পাঁচ ওয়াক্ত নামাজ, জুমা, মক্তব ও কমিউনিটির কার্যক্রম — সবার জন্য উন্মুক্ত।
    </p>
  </div>
</section>

<section class="mx-auto max-w-5xl px-6 py-16">
  {{ b.pill("আজকের নামাজের সময়", "calendar") }}
  <div class="mt-6 rounded-lg border border-line bg-surface p-8">
    {{ b.prayerTable(prayer.times) }}
  </div>
</section>
