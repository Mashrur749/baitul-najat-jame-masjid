---
layout: layouts/base.njk
title: প্রোডাক্টিভ মুসলিম ৩৬০°
description: "ইবাদত, শিক্ষা, সেবা ও নেতৃত্ব একসাথে — বায়তুন নাযাত জামে মসজিদ, শাহজালাল উপশহর, সিলেট। Baitun Najat Jame Masjid, Sylhet — Productive Muslim 360°."
lang: bn
---
{% import "macros/brand.njk" as b %}

{# ══ HERO ══════════════════════════════════════════════════════════════════
   The masjid's name and its vision, then the two actions. Beside it the 360° device:
   the lime sun disc carrying the numeral, the six pillars circling it. #}
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-5xl px-6 pt-10 pb-12 md:pt-16 md:pb-20 grid gap-10 md:grid-cols-[1.25fr_1fr] md:items-center">
    <div>
      {{ b.pill(model.name, "sparkle") }}
      <h1 lang="bn" class="mt-6 font-display font-extrabold text-4xl sm:text-5xl leading-tight text-olive-deep text-balance">{{ site.nameBn }}</h1>
      <p lang="bn" class="mt-5 max-w-xl text-lg sm:text-xl leading-relaxed text-ink">{{ model.vision }}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {{ b.btn("/programs/", "কর্মসূচি দেখুন") }}
        {{ b.btn("/donate/", "দান করুন", "secondary") }}
      </div>
      {# The one English foothold in the first screen, for a funder whose Bangla is weak. #}
      <p lang="en" class="mt-5 max-w-xl text-sm text-ink-muted">Baitun Najat Jame Masjid, Shahjalal Upashahar, Sylhet — worship, learning, service and leadership under one roof.</p>
    </div>

    {# Decorative: every pillar is named in full in the next sections. Positions are the six
       points of a circle, radius 42% of the box, starting at the top. #}
    {% set pos = [["50%","8%"],["86.4%","29%"],["86.4%","71%"],["50%","92%"],["13.6%","71%"],["13.6%","29%"]] %}
    <div aria-hidden="true" class="relative mx-auto w-full max-w-[19rem] md:max-w-sm aspect-square">
      <div class="absolute inset-[8%] rounded-pill border-2 border-dashed border-line"></div>
      <div class="absolute inset-[19%] rounded-pill bg-lime text-ink flex flex-col items-center justify-center">
        <span lang="bn" class="font-display font-extrabold text-5xl md:text-6xl leading-none">৩৬০°</span>
        <span lang="bn" class="mt-2 font-semibold text-sm md:text-base">প্রোডাক্টিভ মুসলিম</span>
      </div>
      {% for p in model.pillars %}
      <span class="absolute -translate-x-1/2 -translate-y-1/2 inline-flex items-center justify-center w-12 h-12 md:w-14 md:h-14 rounded-pill bg-paper border-2 border-olive-deep text-olive-deep"
            style="left:{{ pos[loop.index0][0] }};top:{{ pos[loop.index0][1] }}">{{ b.icon(p.icon, "50%") }}</span>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ PRAYER TIMES ════════════════════════════════════════════════════════════
   From the committee's sheet (src/_data/prayer.js). No complete table, no block: a
   wrong jamaat time is worse than none. #}
{% if prayer %}
<section id="prayer" class="mx-auto max-w-5xl px-6 pb-14 md:pb-20 scroll-mt-24">
  <div class="rounded-lg bg-surface border border-line p-6 md:p-8 grid gap-8 md:grid-cols-[1fr_2fr] md:items-start">
    <div>
      {{ b.pill("নামাজের সময়", "clock") }}
      {% if prayer.jumuah %}<p lang="bn" class="mt-5 text-lg text-ink">জুমার জামাত <span class="font-semibold">{{ prayer.jumuah.iqamah | bn }}</span></p>{% endif %}
      {% if prayer.updated %}<p lang="bn" class="mt-2 text-sm text-ink-muted">হালনাগাদ: {{ prayer.updated | bn }}</p>{% endif %}
    </div>
    {{ b.prayerTable(prayer.times) }}
  </div>
</section>
{% endif %}

{# ══ PILLARS ═════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 pb-14 md:pb-20">
  {{ b.sectionHead("মূল পিলার", "ছয়টি পিলারে দাঁড়ানো একটি মসজিদ") }}
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for p in model.pillars %}
    <li>
      <a href="/360/#{{ p.id }}" class="flex h-full items-center gap-4 rounded-lg bg-surface border border-line p-5 hover:border-olive-deep transition-colors">
        {{ b.iconDisc(p.icon) }}
        <span>
          <span lang="bn" class="block font-display font-extrabold text-lg text-ink leading-snug">{{ p.title }}</span>
          <span lang="en" class="block text-sm text-ink-muted">{{ p.brand }}</span>
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  <a href="/360/" lang="bn" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">পুরো ৩৬০° মডেল দেখুন {{ b.icon("arrow") }}</a>
</section>

{# ══ PROGRAMMES ══════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 pb-14 md:pb-20">
  {{ b.sectionHead("Ilm House · কর্মসূচি", "প্রধান প্রোগ্রাম", "book") }}
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for p in model.programs %}{{ b.tile(p.icon, p.title, p.detail) }}{% endfor %}
  </ul>
  <a href="/programs/" lang="bn" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">সব কর্মসূচি দেখুন {{ b.icon("arrow") }}</a>
</section>

{# ══ MONTHLY FLOW ════════════════════════════════════════════════════════════ #}
<section class="bg-olive-deep text-paper">
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
    <h2 lang="bn" class="font-display font-extrabold text-3xl leading-tight">প্রতি মাসের আয়োজন</h2>
    <p lang="bn" class="mt-2 text-lg">মাসের চার সপ্তাহে চারটি আয়োজন।</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {% for w in model.monthlyFlow %}{{ b.weekTile(w.week, w.title) }}{% endfor %}
    </div>
    <p lang="bn" class="mt-8 text-lg">
      আর প্রতি জুমায় <a href="/programs/#children-khutbah" class="font-semibold underline underline-offset-4 hover:no-underline">শিশুদের খুতবা</a> — {{ model.childrenKhutbah.ages }}, {{ model.childrenKhutbah.when | replace("প্রতি জুমায় ", "") }}।
    </p>
  </div>
</section>

{# ══ SERVICES ════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
  {{ b.sectionHead("Rahma Services", "সামাজিক সেবা", "heart") }}
  <div class="grid gap-6 md:grid-cols-2">
    {% for s in model.services %}{{ b.card(s.icon, s.title, s.items) }}{% endfor %}
  </div>
  {# One call button for every service, not one per card. #}
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
    {{ b.callButton(site.phones[0], "সেবার জন্য কল করুন") }}
    <a href="/services/" lang="bn" class="inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">সেবা ও সুন্নাহ স্টোর {{ b.icon("arrow") }}</a>
  </div>
</section>

{# ══ ANSAR ═══════════════════════════════════════════════════════════════════ #}
<section class="bg-surface border-y border-line">
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20 grid gap-10 md:grid-cols-2 md:items-center">
    <div>
      {{ b.pill(model.ansar.brand, "people") }}
      <h2 class="mt-5 font-display font-extrabold text-3xl text-olive-deep text-balance"><span lang="en">{{ model.ansar.team }}</span> <span lang="bn">— যুব স্বেচ্ছাসেবক টিম</span></h2>
      <p lang="bn" class="mt-4 text-lg leading-relaxed text-ink">মিডিয়া, ইভেন্ট, ওয়েলফেয়ার ও শিক্ষা — চারটি টিমে যুবকদের হাতে মসজিদের কাজ। নিজস্ব রেজিস্ট্রেশন, ব্যাজ ও ইউনিফর্ম।</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {{ b.btn("/ansar/#register", "রেজিস্ট্রেশন করুন") }}
        {{ b.btn("/ansar/", "টিম সম্পর্কে জানুন", "secondary") }}
      </div>
    </div>
    {{ b.figure("/images/event-2026/volunteer-assisting.jpg",
       "স্বেচ্ছাসেবক প্রতিযোগীদের সহায়তা করছেন",
       "৩য় সীরাত প্রতিযোগিতায় মসজিদের স্বেচ্ছাসেবকরা।") }}
  </div>
</section>

{# ══ NAJAT TV ════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
  {{ b.sectionHead("Najat TV", "নাজাত টিভি ও মিডিয়া", "play") }}
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for m in model.media %}{{ b.tile(m.icon, m.title, m.detail) }}{% endfor %}
  </ul>
  <a href="/media/" lang="bn" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">নাজাত টিভি {{ b.icon("arrow") }}</a>
</section>

{# ══ EVENTS ══════════════════════════════════════════════════════════════════ #}
<section class="mx-auto max-w-5xl px-6 pb-14 md:pb-20">
  {{ b.sectionHead("আয়োজন", "সাম্প্রতিক আয়োজন", "calendar") }}
  {% set summary %}{{ event.participants | bn }} জন শিশু-কিশোর সীরাতুন্নবী ﷺ নিয়ে পরীক্ষা দিয়েছে; প্রত্যেকে পেয়েছে একটি সীরাতগ্রন্থ, {{ event.winners.count | bn }} জন পুরস্কার।{% endset %}
  {{ b.eventCard("/events/seerah-2026/", "/images/event-2026/hall-packed.jpg", "পুরস্কার বিতরণী অনুষ্ঠানে পূর্ণ মিলনায়তন",
     event.title, "সম্পন্ন · " + event.occasion, "২২ ও ২৯ আগস্ট ২০২৬ · মসজিদ মিলনায়তন", summary) }}
</section>

{# ══ THE ASK ═════════════════════════════════════════════════════════════════ #}
<section class="bg-olive-deep text-paper">
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-start">
    <div>
      <h2 lang="bn" class="font-display font-extrabold text-3xl md:text-4xl leading-tight text-balance">মসজিদের কাজে শরিক হোন</h2>
      <p lang="en" class="mt-3 text-sm">Support Baitun Najat Jame Masjid, Sylhet.</p>
      <p lang="bn" class="mt-6 text-lg leading-relaxed">শিক্ষা, সেবা ও যুবকদের কাজ — মসজিদের প্রতিটি উদ্যোগ চলে শুভাকাঙ্ক্ষীদের সহযোগিতায়।</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {{ b.btn("/donate/", "দান করুন", "paper") }}
        {{ b.btn("/ansar/", "স্বেচ্ছাসেবক হোন", "paperOutline") }}
      </div>
    </div>
    {{ b.contactCard(event.contact.imam, event.contact.imamTitle, event.contact.primaryPhone, site.nameBn, site.address) }}
  </div>
</section>
