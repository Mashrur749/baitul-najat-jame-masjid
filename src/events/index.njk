---
{% import "macros/brand.njk" as b %}

{{ b.pageHead("আয়োজন", "মসজিদের আয়োজন",
   "কোর্স, প্রতিযোগিতা, আলোচনা সভা ও উৎসব — মসজিদকে ঘিরে যা হয়।",
   "Events at Baitun Najat Jame Masjid, Sylhet.", "calendar") }}

{# Every event is a row in the admins' sheet (src/_data/activities.js). Status — and so which
   list an event sits in — comes from its dates. #}
{% if activities.current.length %}
<section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
  {{ b.sectionHead("চলমান ও আসন্ন", "সামনে যা হচ্ছে") }}
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for a in activities.current %}<li class="flex">{{ b.activityCard(a) }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

{% if activities.past.length %}
<section class="mx-auto max-w-5xl px-6 {{ 'pb-14 md:pb-20' if activities.current.length else 'py-14 md:py-20' }}">
  {{ b.sectionHead("সম্পন্ন", "সাম্প্রতিক আয়োজন") }}
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for a in activities.past %}<li class="flex">{{ b.activityCard(a) }}</li>{% endfor %}
  </ul>
</section>
{% endif %}

{# ══ RECURRING ═══════════════════════════════════════════════════════════════ #}
<section class="bg-surface border-y border-line">
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-20">
    {{ b.sectionHead("নিয়মিত", "প্রতি মাসের আয়োজন", "calendar") }}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {% for w in model.monthlyFlow %}{{ b.weekTile(w.week, w.title) }}{% endfor %}
    </div>
    <a href="/programs/" lang="bn" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink hover:underline">সব কর্মসূচি দেখুন {{ b.icon("arrow") }}</a>
  </div>
</section>
