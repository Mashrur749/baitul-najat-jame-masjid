---
layout: layouts/base.njk
title: আয়োজন
description: "কোর্স, প্রতিযোগিতা, আলোচনা সভা ও মাসিক আয়োজন — বায়তুন নাযাত জামে মসজিদ, সিলেট। Events at Baitun Najat Jame Masjid, Sylhet."
permalink: /events/
lang: bn
---
{% import "macros/brand.njk" as b %}

{# Every event is a row in the admins' sheet (src/_data/activities.js). Status — and so which
   list an event sits in — comes from its dates. The next one is the page's picture; with
   nothing coming up, the head shows a photograph instead. #}
{% set next = activities.current[0] %}
{% call b.pageHead("আয়োজন", "মসজিদের আয়োজন",
   "কোর্স, প্রতিযোগিতা, আলোচনা সভা ও উৎসব — মসজিদকে ঘিরে যা হয়।",
   "Events at Baitun Najat Jame Masjid, Sylhet.", "calendar") %}
  {% if next %}
  <a href="{{ next.href }}" class="group mx-auto block w-full max-w-sm rounded-lg border border-line bg-paper overflow-hidden">
    {% if next.poster %}<img src="{{ next.poster }}" alt="" loading="eager" fetchpriority="high" decoding="async" sizes="(min-width: 768px) 384px, 90vw" class="w-full h-auto">{% endif %}
    <span class="block p-5">
      {{ b.statusPill(next) }}
      <span lang="bn" class="mt-3 block font-display font-extrabold text-xl text-ink leading-snug group-hover:underline">{{ next.title }}</span>
      <span lang="bn" class="mt-1 block text-ink-muted">{{ next.dateText }}</span>
    </span>
  </a>
  {% else %}
  {{ b.archFigure("/images/event-2026/hall-packed.jpg", "প্রতিযোগীতে ভরা মসজিদের হল", "৩য় সীরাত প্রতিযোগিতা ২০২৬।", "4/5", "50% 50%", "mx-auto w-full max-w-sm", true) }}
  {% endif %}
{% endcall %}

{% set rest = activities.current.slice(1) %}
{% if rest.length %}
{# Columns follow the number of cards: a lone card sits beside its heading instead of leaving
   half or two thirds of a 3-column row blank. #}
{% set n = rest.length %}
<section class="mx-auto max-w-5xl px-6 section-y">
  <div class="{{ 'grid md:grid-cols-[1fr_minmax(0,22rem)] md:items-start md:gap-10' if n == 1 }}">
    {{ b.sectionHead("চলমান ও আসন্ন", "সামনে আরও যা হচ্ছে") }}
    <ul class="grid gap-6 {{ 'sm:grid-cols-2' if n >= 2 }} {{ 'lg:grid-cols-3' if n >= 3 }}">
      {% for a in rest %}<li class="flex">{{ b.activityCard(a) }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if activities.past.length %}
<section class="bg-surface border-y border-line">
  {% set n = activities.past.length %}
  <div class="mx-auto max-w-5xl px-6 section-y">
    <div class="{{ 'grid md:grid-cols-[1fr_minmax(0,22rem)] md:items-start md:gap-10' if n == 1 }}">
      {{ b.sectionHead("সম্পন্ন", "সাম্প্রতিক আয়োজন", "check") }}
      <ul class="grid gap-6 {{ 'sm:grid-cols-2' if n >= 2 }} {{ 'lg:grid-cols-3' if n >= 3 }}">
        {% for a in activities.past %}<li class="flex">{{ b.activityCard(a) }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{# ══ RECURRING — the month as a line, on the olive band ══════════════════════
   Paper markers: lime and olive-deep must never touch as fills. #}
<section class="relative overflow-hidden bg-olive-deep text-paper">
  {{ b.pattern("events-lattice", "paper") }}
  <div class="relative mx-auto max-w-5xl px-6 section-y">
    <h2 lang="bn" class="font-display font-extrabold text-3xl lg:text-4xl leading-tight">প্রতি মাসের আয়োজন</h2>
    <ol class="relative mt-8 grid gap-8 md:grid-cols-4 md:gap-6">
      <div aria-hidden="true" class="absolute left-7 top-2 bottom-2 w-0.5 bg-paper/30 md:left-7 md:right-[calc(25%-2.875rem)] md:top-7 md:bottom-auto md:h-0.5 md:w-auto"></div>
      {% for w in model.monthlyFlow %}
      <li class="relative flex items-center gap-5 md:flex-col md:items-start md:gap-4">
        <span class="relative inline-flex w-14 h-14 shrink-0 items-center justify-center rounded-pill bg-paper text-ink font-display font-extrabold text-2xl">{{ w.week | bn }}</span>
        <div>
          <p lang="bn" class="text-sm">সপ্তাহ {{ w.week | bn }}</p>
          <p lang="bn" class="font-display font-bold text-xl leading-snug">{{ w.title }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
    <div class="mt-12">{{ b.btn("/programs/", "সব কর্মসূচি দেখুন", "paperOutline") }}</div>
  </div>
</section>
